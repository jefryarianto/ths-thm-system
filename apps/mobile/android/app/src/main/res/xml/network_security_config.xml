<?xml version="1.0" encoding="utf-8"?>
<!--
  Izinkan cleartext HTTP HANYA untuk host development (emulator loopback &
  jaringan lokal), sehingga build release tetap bisa dipakai dengan API lokal
  (mis. http://localhost:3001 / http://10.0.2.2:3001) tanpa membuka cleartext
  untuk seluruh internet. Trafik ke domain lain tetap wajib HTTPS.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.15</domain>
  </domain-config>
</network-security-config>
