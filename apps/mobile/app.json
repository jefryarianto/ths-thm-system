{
  "expo": {
    "name": "THS-THM",
    "slug": "ths-thm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ths-thm",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.thsthm.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#023c69"
      },
      "package": "org.thsthm.mobile"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-bundled-video",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ocr-a-extended.ttf",
            "./assets/fonts/open-sans-bold.ttf",
            "./assets/fonts/roboto-regular.ttf",
            "./assets/fonts/roboto-bold.ttf",
            "./assets/fonts/Ionicons.ttf"
          ]
        }
      ]
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f9fed5cb-78d4-42b3-a253-a5b3674e8a2c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f9fed5cb-78d4-42b3-a253-a5b3674e8a2c"
      }
    },
    "owner": "jefryarianto"
  }
}
