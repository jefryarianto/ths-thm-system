{
  "plugins": ["react-hooks"],
  "ignorePatterns": [
    "babel.config.js",
    "jest.config.js",
    "jest.setup.js",
    "metro.config.js",
    "react-native.config.js"
  ],
  "parserOptions": {
    "project": ["../../tsconfig.base.json", "./tsconfig.json"]
  },
  "rules": {
    "@typescript-eslint/no-require-imports": "off",
    "@typescript-eslint/no-var-requires": "off",
    "react-hooks/exhaustive-deps": "off"
  }
}
