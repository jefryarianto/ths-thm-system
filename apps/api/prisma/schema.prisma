// ── Prisma Configuration ──────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────

enum TipeUnitLatihan {
  reguler
  khusus
}

enum Role {
  superadmin
  admin_distrik
  admin_wilayah
  admin_ranting
  admin_kegiatan
  penguji
  anggota
}

enum JenisKelamin {
  L
  P
}

enum StatusKeanggotaan {
  aktif
  nonaktif
  pindah
  keluar
  meninggal
}

enum StatusData {
  complete
  incomplete
}

enum StatusValidasi {
  pending
  approved
  rejected
}

enum StatusCalon {
  diusulkan
  mengikuti_pendadaran
  lulus
  gagal
  dibatalkan
}

enum TipeKlaim {
  sertifikat
  piagam
  kartu_anggota
  dokumen_lainnya
}

enum StatusKlaim {
  pending
  diproses
  disetujui
  ditolak
}

enum ScopeType {
  nasional
  distrik
  wilayah
  ranting
  unit_latihan
}

enum TipeKegiatan {
  latihan
  pendadaran
  ujian_tingkat
  rapat
  retret
  pelantikan
  lainnya
}

enum StatusKegiatan {
  draft
  published
  closed
  cancelled
}

enum StatusKelulusan {
  lulus
  gagal
}

enum StatusPenugasanPenguji {
  pending
  approved
  rejected
}

enum StatusValidasiNilai {
  pending
  approved
  rejected
}

enum TipeDokumen {
  kartu_anggota
  sertifikat_pendadaran
  sertifikat_pelatihan
  piagam_prestasi
}

enum StatusDokumen {
  generated
  downloaded
  revoked
}

enum StatusSurat {
  draft
  diterima
  diproses
  terkirim
  diarsipkan
}

enum StatusDisposisi {
  pending
  dibaca
  ditindaklanjuti
}

enum MetodeBayar {
  manual
  transfer
  online
}

enum StatusIuran {
  belum_dibayar
  menunggu_verifikasi
  lunas
  menunggak
}

enum TipeNotifikasi {
  welcome
  data_incomplete
  reminder_latihan
  reminder_pendadaran
  reminder_iuran
  status_klaim
  dokumen_ready
  forum_reply
  forum_solution
  umum
}

// ── Public Content ────────────────────────────────────────

model Berita {
  id        String   @id @default(uuid())
  judul     String
  ringkasan String   @db.Text
  konten    String   @db.Text
  gambar    String?
  tanggal   DateTime @default(now())
  slug      String   @unique
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("berita")
}

model Galeri {
  id        String   @id @default(uuid())
  judul     String
  gambar    String
  tanggal   DateTime @default(now())
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("galeri")
}

model DonasiProgram {
  id         String   @id @default(uuid())
  nama       String
  deskripsi  String   @db.Text
  targetDana Decimal  @map("target_dana") @db.Decimal(65, 30)
  terkumpul  Decimal  @default(0) @map("terkumpul") @db.Decimal(65, 30)
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("donasi_program")
}

model Sejarah {
  id        String   @id @default(uuid())
  konten    String   @db.Text
  isVisible Boolean  @default(true) @map("is_visible")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sejarah")
}

model Sambutan {
  id        String   @id @default(uuid())
  judul     String
  konten    String   @db.Text
  tokoh     String?
  fotoTokoh String?  @map("foto_tokoh")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sambutan")
}

model Organisasi {
  id        String   @id @default(uuid())
  struktur  Json     @map("struktur")
  isVisible Boolean  @default(true) @map("is_visible")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organisasi")
}

// ── Organizational Structure ──────────────────────────────

model Nasional {
  id        String   @id @default(uuid())
  nama      String
  kode      String   @unique
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  distriks      Distrik[]
  kepengurusans Kepengurusan[]

  @@map("nasional")
}

model Distrik {
  id          String   @id @default(uuid())
  nasionalId  String   @map("nasional_id")
  kodeDistrik String   @unique @map("kode_distrik")
  nama        String
  alamat      String?
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  nasional      Nasional       @relation(fields: [nasionalId], references: [id])
  wilayahs      Wilayah[]
  unitLatihans  UnitLatihan[]
  kepengurusans Kepengurusan[]

  @@map("distrik")
}

model Wilayah {
  id          String   @id @default(uuid())
  distrikId   String   @map("distrik_id")
  kodeWilayah String   @map("kode_wilayah")
  nama        String
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  distrik       Distrik        @relation(fields: [distrikId], references: [id], onDelete: Cascade)
  rantings      Ranting[]
  kepengurusans Kepengurusan[]

  @@unique([distrikId, kodeWilayah])
  @@map("wilayah")
}

model Ranting {
  id            String   @id @default(uuid())
  wilayahId     String   @map("wilayah_id")
  kodeRanting   String   @map("kode_ranting")
  nama          String
  lokasiLatihan String?  @map("lokasi_latihan")
  isVisible     Boolean  @default(true) @map("is_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  wilayah       Wilayah           @relation(fields: [wilayahId], references: [id], onDelete: Cascade)
  users         User[]
  anggota       Anggota[]
  calonAnggotas CalonAnggota[]
  latihans      Latihan[]
  kepengurusans Kepengurusan[]
  transferFrom  TransferRequest[] @relation("TransferFrom")
  transferTo    TransferRequest[] @relation("TransferTo")

  @@unique([wilayahId, kodeRanting])
  @@map("ranting")
}

model UnitLatihan {
  id        String          @id @default(uuid())
  distrikId String          @map("distrik_id")
  nama      String
  tipe      TipeUnitLatihan
  lokasi    String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  distrik Distrik @relation(fields: [distrikId], references: [id], onDelete: Cascade)

  @@map("unit_latihan")
}

// ── Users & Members ───────────────────────────────────────

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  namaLengkap        String   @map("nama_lengkap")
  role               Role     @default(anggota)
  rantingId          String?  @map("ranting_id")
  phone              String?  @unique @map("phone")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  fcmToken           String?  @map("fcm_token")
  refreshToken       String?  @map("refresh_token")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  ranting                     Ranting?              @relation(fields: [rantingId], references: [id], onDelete: SetNull)
  notifikasis                 Notifikasi[]
  deviceTokens                DeviceToken[]
  tandaTangans                TandaTangan[]
  disposisiDari               Disposisi[]           @relation("DisposisiDari")
  disposisiKepada             Disposisi[]           @relation("DisposisiKepada")
  calonAnggotasDiusul         CalonAnggota[]        @relation("CalonAnggotaUsul")
  kegiatanDibuat              Kegiatan[]            @relation("KegiatanCreatedBy")
  kegiatanAdminKegiatan       Kegiatan[]            @relation("AdminKegiatan")
  penugasanPengujis           PenugasanPenguji[]
  ujianPraktekPenilais        UjianPraktekPenilai[]
  latihansDipelatih           Latihan[]             @relation("LatihanPelatih")
  nilaiPendadaranPenguji      NilaiPendadaran[]     @relation("NilaiPendadaranPenguji")
  hasilPendadaranDivValidated HasilPendadaran[]     @relation("HasilPendadaranValidasi")
  iuranDiverifikasi           Iuran[]               @relation("IuranVerifikator")
  dokumenOrgUploaded          DokumenOrganisasi[]   @relation("DokumenOrgUploader")
  oauthAccounts               OAuthAccount[]
  auditLogs                   AuditLog[]
  kepengurusans               Kepengurusan[]

  @@map("users")
}

model Anggota {
  id                String            @id @default(uuid())
  rantingId         String            @map("ranting_id")
  nomorAnggota      String            @unique @map("nomor_anggota")
  namaLengkap       String            @map("nama_lengkap")
  jenisKelamin      JenisKelamin      @map("jenis_kelamin")
  tempatLahir       String?           @map("tempat_lahir")
  tanggalLahir      DateTime?         @map("tanggal_lahir")
  tempatDadar       String?           @map("tempat_dadar")
  tahunDadar        String?           @map("tahun_dadar")
  alamat            String?
  noHp              String?           @map("no_hp")
  noHpNormalized    String?           @map("no_hp_normalized")
  email             String?           @unique
  fotoPath          String?           @map("foto_path")
  statusKeanggotaan StatusKeanggotaan @default(aktif) @map("status_keanggotaan")
  tingkat           String?
  statusData        StatusData        @default(complete) @map("status_data")
  statusValidasi    StatusValidasi    @default(pending) @map("status_validasi")
  missingFields     Json?             @map("missing_fields")
  isImported        Boolean           @default(false) @map("is_imported")
  importSource      String?           @map("import_source")
  importedAt        DateTime?         @map("imported_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  ranting                   Ranting                  @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  klaims                    Klaim[]
  dokumen                   Dokumen[]
  iuran                     Iuran[]
  absensiLatihans           AbsensiLatihan[]
  evaluasiLatihans          EvaluasiLatihan[]
  kegiatanPesertas          KegiatanPeserta[]
  presensiKegiatans         PresensiKegiatan[]
  gamificationProfile       GamificationProfile?
  gamificationEvents        GamificationEvent[]
  gamificationRedemptions   GamificationRedemption[]
  nilaiPendadaranAnggota    NilaiPendadaran[]
  ChatMember                ChatMember[]
  ChatMessage               ChatMessage[]
  ForumThread               ForumThread[]
  ForumPost                 ForumPost[]
  qrCodes                   QrCode[]
  checkIns                  CheckIn[]
  undanganPendadarans       UndanganPendadaran[]
  iuranRecurrings           IuranRecurring[]
  memberReferralsAsReferrer MemberReferral[]         @relation("Referrer")
  memberReferralsAsReferred MemberReferral[]         @relation("Referred")
  transferRequests          TransferRequest[]

  @@index([statusData])
  @@index([noHpNormalized])
  @@map("anggota")
}

model CalonAnggota {
  id             String       @id @default(uuid())
  rantingId      String       @map("ranting_id")
  namaLengkap    String       @map("nama_lengkap")
  jenisKelamin   JenisKelamin @map("jenis_kelamin")
  tempatLahir    String?      @map("tempat_lahir")
  tanggalLahir   DateTime?    @map("tanggal_lahir")
  alamat         String?
  noHp           String?      @map("no_hp")
  email          String?      @unique
  tingkat        String?
  status         StatusCalon  @default(diusulkan)
  usulOlehUserId String       @map("usul_oleh_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  ranting          Ranting           @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  usulOlehUser     User              @relation("CalonAnggotaUsul", fields: [usulOlehUserId], references: [id])
  nilaiPendadarans NilaiPendadaran[]
  hasilPendadarans HasilPendadaran[]

  @@map("calon_anggota")
}

model Pendaftaran {
  id           String         @id @default(uuid())
  namaLengkap  String         @map("nama_lengkap")
  jenisKelamin JenisKelamin   @map("jenis_kelamin")
  tempatLahir  String?        @map("tempat_lahir")
  tanggalLahir DateTime?      @map("tanggal_lahir")
  alamat       String?
  noHp         String?        @map("no_hp")
  email        String?
  sumberInfo   String?        @map("sumber_info")
  status       StatusValidasi @default(pending)
  catatan      String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("pendaftaran")
}

// ── Claims ────────────────────────────────────────────────

model Klaim {
  id        String      @id @default(uuid())
  anggotaId String      @map("anggota_id")
  tipe      TipeKlaim
  status    StatusKlaim @default(pending)
  catatan   String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  anggota Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([anggotaId])
  @@map("klaim")
}

// ── Activities & Training ─────────────────────────────────

model Kegiatan {
  id                 String         @id @default(uuid())
  scopeType          ScopeType      @map("scope_type")
  scopeId            String         @map("scope_id")
  nama               String
  tipe               TipeKegiatan
  lokasi             String?
  tanggalMulai       DateTime       @map("tanggal_mulai")
  tanggalSelesai     DateTime       @map("tanggal_selesai")
  createdBy          String         @map("created_by")
  status             StatusKegiatan @default(draft)
  pengajuanNilaiOleh String?        @map("pengajuan_nilai_oleh")
  pengajuanNilaiAt   DateTime?      @map("pengajuan_nilai_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  creator           User                 @relation("KegiatanCreatedBy", fields: [createdBy], references: [id])
  adminKegiatanId   String?              @map("admin_kegiatan_id")
  adminKegiatan     User?                @relation("AdminKegiatan", fields: [adminKegiatanId], references: [id])
  latihans          Latihan[]
  peserta           KegiatanPeserta[]
  presensi          PresensiKegiatan[]
  dokumenKegiatan   DokumenKegiatan[]
  penugasanPengujis PenugasanPenguji[]
  ujianPrakteks     UjianPraktek[]
  nilaiPendadarans  NilaiPendadaran[]
  hasilPendadarans  HasilPendadaran[]
  checkIns          CheckIn[]
  undangans         UndanganPendadaran[]

  @@map("kegiatan")
}

// Undangan pendadaran H-7, dibuat otomatis oleh cron untuk anggota yang
// memenuhi kriteria (masa anggota >2 tahun dari tahun dadar ATAU tingkat Pratama).
// Status: dikirim -> hadir / tidak_hadir (konfirmasi anggota atau catat manual admin).
model UndanganPendadaran {
  id             String         @id @default(uuid())
  kegiatanId     String         @map("kegiatan_id")
  anggotaId      String         @map("anggota_id")
  status         StatusUndangan @default(dikirim)
  dikirimAt      DateTime       @default(now()) @map("dikirim_at")
  konfirmasiAt   DateTime?      @map("konfirmasi_at")
  konfirmasiOleh String?        @map("konfirmasi_oleh")
  catatan        String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  kegiatan Kegiatan @relation(fields: [kegiatanId], references: [id])
  anggota  Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@unique([kegiatanId, anggotaId])
  @@map("undangan_pendadaran")
}

enum StatusUndangan {
  dikirim
  hadir
  tidak_hadir
}

model Latihan {
  id                           String   @id @default(uuid())
  rantingId                    String   @map("ranting_id")
  kegiatanId                   String?  @map("kegiatan_id")
  pelatihId                    String   @map("pelatih_id")
  hariTanggal                  DateTime @map("hari_tanggal")
  lokasi                       String?
  jenisMateri                  String?  @map("jenis_materi")
  hasilLatihanGlobal           String?  @map("hasil_latihan_global")
  rekomendasiLatihanBerikutnya String?  @map("rekomendasi_latihan_berikutnya")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  ranting  Ranting           @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  kegiatan Kegiatan?         @relation(fields: [kegiatanId], references: [id])
  pelatih  User              @relation("LatihanPelatih", fields: [pelatihId], references: [id])
  absensi  AbsensiLatihan[]
  evaluasi EvaluasiLatihan[]
  checkIns CheckIn[]

  @@index([rantingId])
  @@map("latihan")
}

model AbsensiLatihan {
  id        String   @id @default(uuid())
  latihanId String   @map("latihan_id")
  anggotaId String   @map("anggota_id")
  hadir     Boolean  @default(true)
  catatan   String?
  createdAt DateTime @default(now()) @map("created_at")

  latihan Latihan @relation(fields: [latihanId], references: [id], onDelete: Cascade)
  anggota Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@unique([latihanId, anggotaId])
  @@index([anggotaId])
  @@map("absensi_latihan")
}

model EvaluasiLatihan {
  id        String   @id @default(uuid())
  latihanId String   @map("latihan_id")
  anggotaId String   @map("anggota_id")
  nilai     Decimal  @db.Decimal(5, 2)
  catatan   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  latihan Latihan @relation(fields: [latihanId], references: [id], onDelete: Cascade)
  anggota Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([latihanId])
  @@index([anggotaId])
  @@map("evaluasi_latihan")
}

model KegiatanPeserta {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  anggotaId  String   @map("anggota_id")
  createdAt  DateTime @default(now()) @map("created_at")

  kegiatan Kegiatan @relation(fields: [kegiatanId], references: [id])
  anggota  Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@unique([kegiatanId, anggotaId])
  @@index([anggotaId])
  @@map("kegiatan_peserta")
}

model PresensiKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  anggotaId  String   @map("anggota_id")
  hadir      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  kegiatan Kegiatan @relation(fields: [kegiatanId], references: [id])
  anggota  Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@unique([kegiatanId, anggotaId])
  @@index([anggotaId])
  @@map("presensi_kegiatan")
}

model DokumenKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  nama       String
  filePath   String?  @map("file_path")
  tipe       String
  createdAt  DateTime @default(now()) @map("created_at")

  kegiatan Kegiatan @relation(fields: [kegiatanId], references: [id])

  @@map("dokumen_kegiatan")
}

// ── Assessments ───────────────────────────────────────────

model AspekPenilaian {
  id        String   @id @default(uuid())
  kodeAspek String   @unique @map("kode_aspek")
  namaAspek String   @map("nama_aspek")
  deskripsi String?
  bobot     Decimal  @default(0) @db.Decimal(65, 30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itemPenilaian ItemPenilaian[]

  @@index([kodeAspek])
  @@map("aspek_penilaian")
}

model PenugasanPenguji {
  id            String                 @id @default(uuid())
  pengujiUserId String                 @map("penguji_user_id")
  kegiatanId    String                 @map("kegiatan_id")
  peran         String?                @default("penguji")
  catatan       String?
  status        StatusPenugasanPenguji @default(pending)
  disetujuiOleh String?                @map("disetujui_oleh")
  disetujuiAt   DateTime?              @map("disetujui_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  pengujiUser   User                   @relation(fields: [pengujiUserId], references: [id])
  kegiatan      Kegiatan               @relation(fields: [kegiatanId], references: [id])

  @@map("penugasan_penguji")
}

model ItemPenilaian {
  id           String   @id @default(uuid())
  aspekId      String   @map("aspek_id")
  kodeItem     String   @unique @map("kode_item")
  namaItem     String   @map("nama_item")
  skorMaksimal Decimal  @default(100) @map("skor_maksimal") @db.Decimal(65, 30)
  bobot        Decimal  @default(1) @db.Decimal(65, 30)
  urutan       Int
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  aspek             AspekPenilaian     @relation(fields: [aspekId], references: [id])
  nilaiPendadarans  NilaiPendadaran[]
  ujianPraktekItems UjianPraktekItem[]

  @@index([kodeItem])
  @@map("item_penilaian")
}

model NilaiPendadaran {
  id              String              @id @default(uuid())
  kegiatanId      String              @map("kegiatan_id")
  calonAnggotaId  String              @map("calon_anggota_id")
  anggotaId       String?             @map("anggota_id")
  itemPenilaianId String              @map("item_penilaian_id")
  pengujiUserId   String              @map("penguji_user_id")
  ujianPraktekId  String?             @map("ujian_praktek_id")
  skor            Decimal             @db.Decimal(5, 2)
  komentar        String?
  statusValidasi  StatusValidasiNilai @default(pending) @map("status_validasi")
  divalidasiOleh  String?             @map("divalidasi_oleh")
  divalidasiAt    DateTime?           @map("divalidasi_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  kegiatan      Kegiatan      @relation(fields: [kegiatanId], references: [id])
  calonAnggota  CalonAnggota  @relation(fields: [calonAnggotaId], references: [id], onDelete: Cascade)
  anggota       Anggota?      @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  itemPenilaian ItemPenilaian @relation(fields: [itemPenilaianId], references: [id])
  penguji       User          @relation("NilaiPendadaranPenguji", fields: [pengujiUserId], references: [id])
  ujianPraktek  UjianPraktek? @relation(fields: [ujianPraktekId], references: [id])

  @@index([kegiatanId, calonAnggotaId])
  @@index([pengujiUserId])
  @@index([itemPenilaianId])
  @@map("nilai_pendadaran")
}

model HasilPendadaran {
  id              String          @id @default(uuid())
  kegiatanId      String          @map("kegiatan_id")
  calonAnggotaId  String          @map("calon_anggota_id")
  totalSkor       Decimal         @map("total_skor") @db.Decimal(5, 2)
  ranking         Int?
  statusKelulusan StatusKelulusan @map("status_kelulusan")
  statusValidasi  StatusValidasi  @default(pending) @map("status_validasi")
  divalidasiOleh  String?         @map("divalidasi_oleh")
  divalidasiAt    DateTime?       @map("divalidasi_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  kegiatan       Kegiatan     @relation(fields: [kegiatanId], references: [id])
  calonAnggota   CalonAnggota @relation(fields: [calonAnggotaId], references: [id], onDelete: Cascade)
  divalidasiUser User?        @relation("HasilPendadaranValidasi", fields: [divalidasiOleh], references: [id])

  @@index([kegiatanId, calonAnggotaId])
  @@map("hasil_pendadaran")
}

// ── Practical Exams (Ujian Praktek) within Pendadaran ──

enum StatusUjianPraktek {
  draft
  berlangsung
  selesai
  dibatalkan
}

model UjianPraktek {
  id          String             @id @default(uuid())
  kegiatanId  String             @map("kegiatan_id")
  nama        String
  deskripsi   String?
  tanggal     DateTime?
  durasiMenit Int?               @map("durasi_menit")
  status      StatusUjianPraktek @default(draft)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  kegiatan   Kegiatan              @relation(fields: [kegiatanId], references: [id])
  penilais   UjianPraktekPenilai[]
  items      UjianPraktekItem[]
  penilaians NilaiPendadaran[]

  @@index([kegiatanId])
  @@map("ujian_praktek")
}

model UjianPraktekPenilai {
  id             String   @id @default(uuid())
  ujianPraktekId String   @map("ujian_praktek_id")
  pengujiUserId  String   @map("penguji_user_id")
  catatan        String?
  createdAt      DateTime @default(now()) @map("created_at")

  ujianPraktek UjianPraktek @relation(fields: [ujianPraktekId], references: [id], onDelete: Cascade)
  pengujiUser  User         @relation(fields: [pengujiUserId], references: [id])

  @@unique([ujianPraktekId, pengujiUserId])
  @@map("ujian_praktek_penilai")
}

model UjianPraktekItem {
  id              String   @id @default(uuid())
  ujianPraktekId  String   @map("ujian_praktek_id")
  itemPenilaianId String   @map("item_penilaian_id")
  urutan          Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  ujianPraktek  UjianPraktek  @relation(fields: [ujianPraktekId], references: [id], onDelete: Cascade)
  itemPenilaian ItemPenilaian @relation(fields: [itemPenilaianId], references: [id])

  @@unique([ujianPraktekId, itemPenilaianId])
  @@index([ujianPraktekId])
  @@map("ujian_praktek_item")
}

// ── Documents ─────────────────────────────────────────────

model Dokumen {
  id              String        @id @default(uuid())
  anggotaId       String        @map("anggota_id")
  tipe            TipeDokumen
  nomorDokumen    String        @unique @map("nomor_dokumen")
  filePath        String?       @map("file_path")
  verificationUrl String?       @map("verification_url")
  signatureId     String?       @map("signature_id")
  stampId         String?       @map("stamp_id")
  status          StatusDokumen @default(generated)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  anggota      Anggota       @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  qrValidation QRValidation?

  @@index([anggotaId])
  @@map("dokumen")
}

model QRValidation {
  id        String    @id @default(uuid())
  dokumenId String    @unique @map("dokumen_id")
  token     String    @unique
  isValid   Boolean   @default(true) @map("is_valid")
  scannedAt DateTime? @map("scanned_at")
  scanCount Int       @default(0) @map("scan_count")
  createdAt DateTime  @default(now()) @map("created_at")

  dokumen Dokumen @relation(fields: [dokumenId], references: [id], onDelete: Cascade)

  @@map("qr_validation")
}

model TandaTangan {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  nama      String
  jabatan   String
  imagePath String   @map("image_path")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("tanda_tangan")
}

model Stempel {
  id        String   @id @default(uuid())
  nama      String
  imagePath String   @map("image_path")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stempel")
}

// ── Org Documents ─────────────────────────────────────────

model DokumenOrganisasi {
  id         String   @id @default(uuid())
  kategoriId String   @map("kategori_id")
  judul      String
  deskripsi  String?
  filePath   String   @map("file_path")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  kategori KategoriDokumen @relation(fields: [kategoriId], references: [id])
  uploader User            @relation("DokumenOrgUploader", fields: [uploadedBy], references: [id])

  @@map("dokumen_organisasi")
}

model KategoriDokumen {
  id        String   @id @default(uuid())
  nama      String
  deskripsi String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dokumen DokumenOrganisasi[]

  @@map("kategori_dokumen")
}

// ── Letters ───────────────────────────────────────────────

model SuratMasuk {
  id            String      @id @default(uuid())
  nomorSurat    String      @map("nomor_surat")
  tanggalSurat  DateTime    @map("tanggal_surat")
  tanggalTerima DateTime    @map("tanggal_terima")
  pengirim      String
  perihal       String
  fileScanPath  String?     @map("file_scan_path")
  status        StatusSurat @default(diterima)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  disposisis Disposisi[]

  @@map("surat_masuk")
}

model SuratKeluar {
  id           String      @id @default(uuid())
  nomorSurat   String      @map("nomor_surat")
  tanggalSurat DateTime    @map("tanggal_surat")
  tujuan       String
  perihal      String
  isi          String?
  filePath     String?     @map("file_path")
  status       StatusSurat @default(draft)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("surat_keluar")
}

model Disposisi {
  id           String          @id @default(uuid())
  suratMasukId String          @map("surat_masuk_id")
  dariUserId   String          @map("dari_user_id")
  kepadaUserId String          @map("kepada_user_id")
  isi          String
  status       StatusDisposisi @default(pending)
  createdAt    DateTime        @default(now()) @map("created_at")

  suratMasuk SuratMasuk @relation(fields: [suratMasukId], references: [id])
  dariUser   User       @relation("DisposisiDari", fields: [dariUserId], references: [id])
  kepadaUser User       @relation("DisposisiKepada", fields: [kepadaUserId], references: [id])

  @@index([suratMasukId])
  @@map("disposisi")
}

// ── Dues & Payments ───────────────────────────────────────

model BankInfo {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountName   String   @map("account_name")
  qrisImageUrl  String?  @map("qris_image_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bank_info")
}

model Iuran {
  id               String      @id @default(uuid())
  anggotaId        String      @map("anggota_id")
  periode          String
  jumlah           Decimal     @db.Decimal(10, 2)
  tanggalBayar     DateTime?   @map("tanggal_bayar")
  metodeBayar      MetodeBayar @default(manual) @map("metode_bayar")
  status           StatusIuran @default(belum_dibayar)
  buktiBayarPath   String?     @map("bukti_bayar_path")
  diverifikasiOleh String?     @map("diverifikasi_oleh")
  diverifikasiAt   DateTime?   @map("diverifikasi_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  anggota     Anggota              @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  verifikator User?                @relation("IuranVerifikator", fields: [diverifikasiOleh], references: [id])
  payments    PaymentTransaction[]

  @@index([status])
  @@index([anggotaId])
  @@map("iuran")
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  iuranId       String   @map("iuran_id")
  orderId       String   @unique @map("order_id")
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @default("pending")
  paymentType   String?  @map("payment_type")
  transactionId String?  @map("transaction_id")
  rawResponse   Json?    @map("raw_response")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  iuran Iuran @relation(fields: [iuranId], references: [id], onDelete: Cascade)

  @@index([iuranId])
  @@index([orderId])
  @@map("payment_transactions")
}

// ── Notifications ─────────────────────────────────────────

model Notifikasi {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  judul     String
  isi       String
  tipe      TipeNotifikasi
  isRead    Boolean        @default(false) @map("is_read")
  data      Json?
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifikasi")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("android")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}

// ── Email Templates (custom overrides) ─────────────────

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique // matches function name in email-templates.ts
  subject   String // override subject (template variables: {{nama}}, etc.)
  htmlBody  String   @map("html_body") // override HTML body (with {{variable}} placeholders)
  isActive  Boolean  @default(true) @map("is_active")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// ── Audit Trail ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  action    String // e.g., 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', 'LOGOUT', 'REFRESH_TOKEN'
  entity    String // e.g., 'User', 'Assessment', 'Document', 'Approval'
  entityId  String?  @map("entity_id")
  userId    String?  @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   Json? // Before/after data, additional context
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ── Import Logs (Audit Trail) ───────────────────────────

model ImportLog {
  id          String   @id @default(uuid())
  module      String // 'candidates' | 'members' | 'dues'
  fileName    String?  @map("file_name")
  totalRows   Int      @map("total_rows")
  successRows Int      @map("success_rows")
  errorRows   Int      @map("error_rows")
  details     Json? // summary of errors for quick audit
  importedBy  String?  @map("imported_by")
  importedAt  DateTime @default(now()) @map("imported_at")

  @@index([module])
  @@index([importedAt(sort: Desc)])
  @@map("import_logs")
}

// ── Email Logs ───────────────────────────────────────────

model SuppressedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String // 'bounced' | 'complained' | 'manual'
  eventId   String?  @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  event EmailEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("suppressed_emails")
}

model EmailEvent {
  id         String   @id @default(uuid())
  emailLogId String?  @map("email_log_id")
  event      String // 'delivered' | 'opened' | 'clicked' | 'bounced' | 'complained'
  recipient  String?
  timestamp  DateTime @default(now())
  data       Json? // Raw webhook payload for the event
  createdAt  DateTime @default(now()) @map("created_at")

  emailLog     EmailLog?         @relation(fields: [emailLogId], references: [id], onDelete: SetNull)
  suppressions SuppressedEmail[]

  @@index([emailLogId])
  @@index([event])
  @@index([timestamp(sort: Desc)])
  @@map("email_events")
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  status    String // 'sent' | 'failed' | 'skipped'
  provider  String? // 'resend' | 'smtp' | 'dev'
  error     String?
  content   String? // HTML/text body for retry capability
  metadata  Json? // { module?: string, template?: string, userId?: string }
  createdAt DateTime @default(now()) @map("created_at")

  events EmailEvent[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([to])
  @@map("email_logs")
}

model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  provider   String
  providerId String   @map("provider_id")
  email      String?
  name       String
  photo      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ── Settings ──────────────────────────────────────────────

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ── National Holidays ────────────────────────────────────

model NationalHoliday {
  id        String   @id @default(uuid())
  date      DateTime @map("date")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, name])
  @@index([date])
  @@index([date, isActive])
  @@map("national_holidays")
}

model Periode {
  id         String   @id @default(uuid())
  nama       String
  tglMulai   DateTime @map("tgl_mulai")
  tglSelesai DateTime @map("tgl_selesai")
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pengurus Kepengurusan[]

  @@map("periode")
}

model Jabatan {
  id        String   @id @default(uuid())
  nama      String   @unique
  kode      String?  @unique
  urutan    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pengurus Kepengurusan[]

  @@map("jabatan")
}

model Kepengurusan {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  jabatanId  String   @map("jabatan_id")
  periodeId  String   @map("periode_id")
  nasionalId String?  @map("nasional_id")
  distrikId  String?  @map("distrik_id")
  wilayahId  String?  @map("wilayah_id")
  rantingId  String?  @map("ranting_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  jabatan Jabatan @relation(fields: [jabatanId], references: [id])
  periode Periode @relation(fields: [periodeId], references: [id])

  nasional Nasional? @relation(fields: [nasionalId], references: [id])
  distrik  Distrik?  @relation(fields: [distrikId], references: [id], onDelete: Cascade)
  wilayah  Wilayah?  @relation(fields: [wilayahId], references: [id], onDelete: Cascade)
  ranting  Ranting?  @relation(fields: [rantingId], references: [id], onDelete: Cascade)

  @@map("kepengurusan")
}

// ── Gamification ──────────────────────────────────────────

model GamificationProfile {
  id            String   @id @default(uuid()) @db.Uuid
  anggotaId     String   @unique @map("anggota_id")
  points        Int      @default(0)
  latihanStreak Int      @default(0) @map("latihan_streak")
  iuranStreak   Int      @default(0) @map("iuran_streak")
  lastActivity  DateTime @default(now()) @map("last_activity")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  anggota Anggota             @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  badges  GamificationBadge[]
  events  GamificationEvent[]

  @@index([points(sort: Desc)])
  @@index([anggotaId])
  @@index([points(sort: Desc), anggotaId])
  @@map("gamification_profiles")
}

model GamificationBadge {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  badgeId     String   @map("badge_id")
  name        String
  description String
  icon        String
  category    String
  earnedAt    DateTime @default(now()) @map("earned_at")

  profile GamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([badgeId])
  @@index([profileId, badgeId])
  @@map("gamification_badges")
}

model GamificationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  anggotaId   String   @map("anggota_id")
  type        String
  points      Int
  description String
  timestamp   DateTime @default(now())

  profile GamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  anggota Anggota             @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([anggotaId])
  @@index([timestamp(sort: Desc)])
  @@index([profileId, timestamp(sort: Desc)])
  @@map("gamification_events")
}

model GamificationReward {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  icon        String   @default("🎁")
  pointCost   Int      @map("point_cost")
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  redemptions GamificationRedemption[]

  @@map("gamification_rewards")
}

model GamificationRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  rewardId    String   @map("reward_id") @db.Uuid
  anggotaId   String   @map("anggota_id")
  pointsSpent Int      @map("points_spent")
  status      String   @default("pending")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reward  GamificationReward @relation(fields: [rewardId], references: [id])
  anggota Anggota            @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([rewardId])
  @@index([anggotaId])
  @@map("gamification_redemptions")
}

// ── Chat & Messaging ──────────────────────────────────────

model ChatRoom {
  id        String   @id @default(uuid())
  name      String?
  type      String   @default("direct")
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ChatMember[]
  messages ChatMessage[]

  @@index([type])
  @@map("chat_rooms")
}

model ChatMember {
  id         String    @id @default(uuid())
  roomId     String    @map("room_id")
  anggotaId  String    @map("anggota_id")
  role       String    @default("member")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  room    ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  anggota Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@unique([roomId, anggotaId])
  @@index([roomId])
  @@index([anggotaId])
  @@map("chat_members")
}

model ChatMessage {
  id        String    @id @default(uuid())
  roomId    String    @map("room_id")
  senderId  String    @map("sender_id")
  content   String    @db.Text
  type      String    @default("text")
  status    String    @default("sent")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender Anggota  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt(sort: Desc)])
  @@map("chat_messages")
}

// ── Forum Community ───────────────────────────────────────

model ForumCategory {
  id        String   @id @default(uuid())
  nama      String
  deskripsi String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  authorId   String   @map("author_id")
  judul      String
  konten     String   @db.Text
  isPinned   Boolean  @default(false) @map("is_pinned")
  isLocked   Boolean  @default(false) @map("is_locked")
  viewCount  Int      @default(0) @map("view_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category ForumCategory @relation(fields: [categoryId], references: [id])
  author   Anggota       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts    ForumPost[]

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("forum_threads")
}

model ForumPost {
  id         String   @id @default(uuid())
  threadId   String   @map("thread_id")
  authorId   String   @map("author_id")
  konten     String   @db.Text
  isSolution Boolean  @default(false) @map("is_solution")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author Anggota     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
  @@map("forum_posts")
}

// ── QR Code & Check-ins ───────────────────────────────────

model QrCode {
  id        String    @id @default(uuid())
  anggotaId String    @map("anggota_id")
  token     String    @unique
  type      String    @default("member")
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  anggota  Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([token])
  @@index([anggotaId])
  @@map("qr_codes")
}

model CheckIn {
  id         String   @id @default(uuid())
  qrCodeId   String   @map("qr_code_id")
  anggotaId  String   @map("anggota_id")
  latihanId  String?  @map("latihan_id")
  kegiatanId String?  @map("kegiatan_id")
  checkedAt  DateTime @default(now()) @map("checked_at")
  source     String   @default("qr_scan")

  qrCode   QrCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  anggota  Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  latihan  Latihan?  @relation(fields: [latihanId], references: [id], onDelete: Cascade)
  kegiatan Kegiatan? @relation(fields: [kegiatanId], references: [id])

  @@index([anggotaId])
  @@index([checkedAt(sort: Desc)])
  @@map("check_ins")
}

// ── Approval Workflow ─────────────────────────────────────

model ApprovalLevel {
  id       String  @id @default(uuid())
  name     String
  roleName String
  order    Int
  isActive Boolean @default(true) @map("is_active")

  requests ApprovalRequestLevel[]

  @@index([order])
  @@map("approval_levels")
}

model ApprovalRequest {
  id          String    @id @default(uuid())
  requestType String
  itemId      String
  submittedBy String    @map("submitted_by")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  levels ApprovalRequestLevel[]

  @@index([requestType])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalRequestLevel {
  requestId       String    @map("request_id")
  approvalLevelId String    @map("approval_level_id")
  status          String    @default("pending")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  note            String?

  request       ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approvalLevel ApprovalLevel   @relation(fields: [approvalLevelId], references: [id], onDelete: Cascade)

  @@unique([requestId, approvalLevelId])
  @@map("approval_request_levels")
}

// ── Recurring Iuran ───────────────────────────────────────

model IuranRecurring {
  id          String   @id @default(uuid())
  anggotaId   String   @map("anggota_id")
  amount      Decimal  @db.Decimal(65, 30)
  frequency   String   @default("monthly")
  nextDueDate DateTime @map("next_due_date")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  anggota Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([anggotaId])
  @@map("iuran_recurring")
}

model IuranReminder {
  id      String   @id @default(uuid())
  iuranId String   @map("iuran_id")
  sentAt  DateTime @default(now()) @map("sent_at")
  channel String   @default("email")
  status  String   @default("sent")

  @@index([iuranId])
  @@map("iuran_reminders")
}

// ── Member Referral ──────────────────────────────────────

model MemberReferral {
  id           String   @id @default(uuid())
  referrerId   String   @map("referrer_id")
  referredId   String   @unique @map("referred_id")
  status       String   @default("pending")
  rewardPoints Int      @default(100)
  createdAt    DateTime @default(now()) @map("created_at")

  referrer Anggota @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Anggota @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("member_referrals")
}

// ── Document Versioning ──────────────────────────────────

model DokumenVersion {
  id        String   @id @default(uuid())
  dokumenId String   @map("dokumen_id")
  version   Int      @default(1)
  filePath  String   @map("file_path")
  changes   String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([dokumenId])
  @@map("dokumen_versions")
}

// ── Document Batch Jobs (Queue System) ──────────────────

enum BatchStatus {
  pending
  processing
  completed
  completed_with_errors
  cancelled
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

model DocumentBatchJob {
  id        String      @id @default(uuid())
  type      String // 'kta' | 'sertifikat_pendadaran' | 'sertifikat_pelatihan' | 'piagam_prestasi'
  totalJobs Int         @map("total_jobs")
  completed Int         @default(0) @map("completed")
  failed    Int         @default(0) @map("failed")
  status    BatchStatus @default(pending)
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  jobs DocumentJob[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("document_batch_jobs")
}

model DocumentJob {
  id           String    @id @default(uuid())
  batchId      String    @map("batch_id")
  memberId     String    @map("member_id")
  nomorDokumen String?   @map("nomor_dokumen")
  status       JobStatus @default(pending)
  error        String?
  retryCount   Int       @default(0) @map("retry_count")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  batch DocumentBatchJob @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@map("document_jobs")
}

// ── Bulk Notifications ───────────────────────────────────

model BulkNotification {
  id          String    @id @default(uuid())
  title       String
  content     String
  targetType  String    @default("all")
  targetIds   Json?     @map("target_ids")
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  status      String    @default("draft")
  totalSent   Int       @default(0) @map("total_sent")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("bulk_notifications")
}

// ── Monitoring Alerts (Threshold + Notification Channels) ─

enum AlertMetric {
  cpu_percent
  memory_percent
  disk_percent
  db_down
  queue_down
  api_down
  queue_downtime_ms
  queue_latency_ms
  queue_failed_jobs
}

enum AlertChannel {
  telegram
  email
}

model MonitoringAlert {
  id               String         @id @default(uuid())
  name             String // Human-readable name
  metric           AlertMetric // What to measure
  operator         String // 'gt' | 'gte' | 'lt' | 'lte'
  threshold        Float // Value to compare against
  duration         Int            @default(0) // Seconds the condition must persist before alerting
  channels         AlertChannel[] // Notification channels
  telegramBotToken String?        @map("telegram_bot_token")
  telegramChatId   String?        @map("telegram_chat_id")
  emailRecipients  String?        @map("email_recipients") // Comma-separated emails
  cooldown         Int            @default(300) // Seconds between alerts (min 5 min)
  isActive         Boolean        @default(true) @map("is_active")
  lastTriggeredAt  DateTime?      @map("last_triggered_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("monitoring_alerts")
}

// ── Queue Uptime Events (Persistent Disconnect Tracking) ─

model QueueUptimeEvent {
  id         String    @id @default(uuid())
  startTime  DateTime  @map("start_time")
  endTime    DateTime? @map("end_time")
  durationMs Int?      @map("duration_ms")
  notes      String? // Root cause / notes from admin
  component  String?   @default("queue") // 'queue' | 'api' | 'database' | 'other'
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([startTime(sort: Desc)])
  @@map("queue_uptime_events")
}

// ── Member Transfer (Mutasi) ─────────────────────────────

model TransferRequest {
  id            String    @id @default(uuid())
  anggotaId     String    @map("anggota_id")
  fromRantingId String    @map("from_ranting_id")
  toRantingId   String    @map("to_ranting_id")
  reason        String?
  scope         String    @default("distrik") // 'distrik' | 'nasional'
  status        String    @default("pending")
  requestedBy   String?   @map("requested_by")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  rejectedBy    String?   @map("rejected_by")
  rejectedAt    DateTime? @map("rejected_at")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  anggota     Anggota            @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  fromRanting Ranting            @relation("TransferFrom", fields: [fromRantingId], references: [id], onDelete: Cascade)
  toRanting   Ranting            @relation("TransferTo", fields: [toRantingId], references: [id], onDelete: Cascade)
  approvals   TransferApproval[]

  @@index([status])
  @@map("transfer_requests")
}

model TransferApproval {
  id                String    @id @default(uuid())
  transferRequestId String    @map("transfer_request_id")
  side              String // 'asal' | 'tujuan'
  level             String // 'ranting' | 'wilayah' | 'distrik'
  status            String    @default("pending")
  order             Int       @default(0)
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  transferRequest TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  @@unique([transferRequestId, side, level])
  @@index([status])
  @@map("transfer_approvals")
}

// ── Predictive Analytics ─────────────────────────────────

model RiskFlag {
  id        String   @id @default(uuid())
  anggotaId String   @map("anggota_id")
  riskType  String
  score     Decimal  @db.Decimal(5, 4)
  factors   Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([anggotaId])
  @@map("risk_flags")
}

// ── Penandatangan (tanda tangan pada kartu/sertifikat) ────────────────────

model Penandatangan {
  id        String   @id @default(uuid())
  nama      String
  jabatan   String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dokumenPenandatangans DokumenPenandatangan[]

  @@index([isActive])
  @@map("penandatangans")
}

/// Penugasan penandatangan per tipe dokumen (1-3 orang, diurutkan via `urutan`).
model DokumenPenandatangan {
  id              String   @id @default(uuid())
  dokumenType     String   @map("dokumen_type")
  penandatanganId String   @map("penandatangan_id")
  urutan          Int
  createdAt       DateTime @default(now()) @map("created_at")

  penandatangan Penandatangan @relation(fields: [penandatanganId], references: [id], onDelete: Cascade)

  @@unique([dokumenType, urutan])
  @@index([dokumenType])
  @@map("dokumen_penandatangans")
}

// ── Tingkatan (pengaturan strip pada kartu anggota) ─────────────────────

/// Pengaturan visual strip di kartu anggota per tingkatan.
/// `stripCount` = jumlah balok (0 = tanpa strip, mis. tingkat Anggota).
/// `stripWarna` = warna balok (hex) — Pratama/Tamtama biru, Muda/Madya/Utama kuning.
model Tingkatan {
  id         String   @id @default(uuid())
  nama       String   @unique
  stripCount Int      @default(0) @map("strip_count")
  stripWarna String   @default("#94a3b8") @map("strip_warna")
  urutan     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([urutan])
  @@map("tingkatan")
}
