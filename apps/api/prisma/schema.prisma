/// `stripWarna` = warna balok (hex) — Pratama/Tamtama biru, Muda/Madya/Utama kuning.
model Tingkatan {
  id         String   @id @default(uuid())
  nama       String   @unique
  stripCount Int      @default(0) @map("strip_count")
  stripWarna String   @default("#94a3b8") @map("strip_warna")
  urutan     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([urutan])
  @@map("tingkatan")
}

model FeatureFlag {
  id        String   @id @default(uuid())
  key       String   @unique
  isEnabled Boolean  @default(false) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model RoleMenuPermission {
  id        String   @id @default(uuid())
  role      String
  menuKey   String   @map("menu_key")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, menuKey])
  @@map("role_menu_permissions")
}

model RolePermission {
  id        String   @id @default(uuid())
  role      String
  key       String
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, key])
  @@map("role_permissions")
}

