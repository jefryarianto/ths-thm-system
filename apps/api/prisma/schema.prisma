generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Berita {
  id        String   @id @default(uuid())
  judul     String
  ringkasan String
  konten    String
  gambar    String?
  tanggal   DateTime @default(now())
  slug      String   @unique
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("berita")
}

model Galeri {
  id             String       @id @default(uuid())
  judul          String
  gambar         String
  tanggal        DateTime     @default(now())
  isVisible      Boolean      @default(false) @map("is_visible")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  status         StatusGaleri @default(PENDING)
  storageKey     String?      @unique @map("storage_key")
  fileName       String?      @map("file_name")
  mimeType       String?      @map("mime_type")
  ukuranBytes    Int?         @map("ukuran_bytes")
  uploaderId     String?      @map("uploader_id")
  reviewerId     String?      @map("reviewer_id")
  rejectedReason String?      @map("rejected_reason")
  reviewedAt     DateTime?    @map("reviewed_at")
  reviewer       User?        @relation("GaleriReviewer", fields: [reviewerId], references: [id])
  uploader       User?        @relation("GaleriUploader", fields: [uploaderId], references: [id])

  @@index([status, isVisible, tanggal])
  @@index([uploaderId])
  @@map("galeri")
}

model DonasiProgram {
  id         String   @id @default(uuid())
  nama       String
  deskripsi  String
  targetDana Decimal  @map("target_dana")
  terkumpul  Decimal  @default(0) @map("terkumpul")
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("donasi_program")
}

model Sejarah {
  id        String   @id @default(uuid())
  konten    String
  isVisible Boolean  @default(true) @map("is_visible")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sejarah")
}

model Sambutan {
  id        String   @id @default(uuid())
  judul     String
  konten    String
  tokoh     String?
  fotoTokoh String?  @map("foto_tokoh")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sambutan")
}

model Organisasi {
  id        String   @id @default(uuid())
  struktur  Json     @map("struktur")
  isVisible Boolean  @default(true) @map("is_visible")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organisasi")
}

model Nasional {
  id            String         @id @default(uuid())
  nama          String
  kode          String         @unique
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  isVisible     Boolean        @default(true) @map("is_visible")
  distriks      Distrik[]
  kepengurusans Kepengurusan[]

  @@map("nasional")
}

model Distrik {
  id                    String                 @id @default(uuid())
  nasionalId            String                 @map("nasional_id")
  kodeDistrik           String                 @unique @map("kode_distrik")
  nama                  String
  alamat                String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  isVisible             Boolean                @default(true) @map("is_visible")
  cardTemplates         CardTemplate[]
  nasional              Nasional               @relation(fields: [nasionalId], references: [id])
  dokumenPenandatangans DokumenPenandatangan[]
  jabatans              Jabatan[]
  kepengurusans         Kepengurusan[]
  penandatangans        Penandatangan[]
  stempels              Stempel[]
  tandaTangans          TandaTangan[]
  unitLatihans          UnitLatihan[]
  userScopes            User[]                 @relation("UserDistrikScope")
  wilayahs              Wilayah[]

  @@map("distrik")
}

model Wilayah {
  id            String         @id @default(uuid())
  distrikId     String         @map("distrik_id")
  kodeWilayah   String         @map("kode_wilayah")
  nama          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  isVisible     Boolean        @default(true) @map("is_visible")
  kepengurusans Kepengurusan[]
  rantings      Ranting[]
  userScopes    User[]         @relation("UserWilayahScope")
  distrik       Distrik        @relation(fields: [distrikId], references: [id], onDelete: Cascade)

  @@unique([distrikId, kodeWilayah])
  @@map("wilayah")
}

model Ranting {
  id            String            @id @default(uuid())
  wilayahId     String            @map("wilayah_id")
  kodeRanting   String            @map("kode_ranting")
  nama          String
  lokasiLatihan String?           @map("lokasi_latihan")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  isVisible     Boolean           @default(true) @map("is_visible")
  anggota       Anggota[]
  auditLogs     AuditLog[]
  calonAnggotas CalonAnggota[]
  kepengurusans Kepengurusan[]
  klaims        Klaim[]
  latihans      Latihan[]
  pendaftarans  Pendaftaran[]
  wilayah       Wilayah           @relation(fields: [wilayahId], references: [id], onDelete: Cascade)
  transferFrom  TransferRequest[] @relation("TransferFrom")
  transferTo    TransferRequest[] @relation("TransferTo")
  users         User[]

  @@unique([wilayahId, kodeRanting])
  @@map("ranting")
}

model UnitLatihan {
  id        String          @id @default(uuid())
  distrikId String          @map("distrik_id")
  nama      String
  tipe      TipeUnitLatihan
  lokasi    String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  distrik   Distrik         @relation(fields: [distrikId], references: [id], onDelete: Cascade)

  @@map("unit_latihan")
}

model User {
  id                          String                @id @default(uuid())
  email                       String                @unique
  passwordHash                String                @map("password_hash")
  namaLengkap                 String                @map("nama_lengkap")
  role                        Role                  @default(anggota)
  rantingId                   String?               @map("ranting_id")
  fcmToken                    String?               @map("fcm_token")
  refreshToken                String?               @map("refresh_token")
  isActive                    Boolean               @default(true) @map("is_active")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  phone                       String?               @unique @map("phone")
  mustChangePassword          Boolean               @default(false) @map("must_change_password")
  failedLoginAttempts         Int                   @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime?             @map("locked_until")
  totpSecret                  String?               @map("totp_secret")
  totpEnabled                 Boolean               @default(false) @map("totp_enabled")
  totpVerifiedAt              DateTime?             @map("totp_verified_at")
  distrikId                   String?               @map("distrik_id")
  wilayahId                   String?               @map("wilayah_id")
  anggotaCreated              Anggota[]             @relation("AnggotaCreatedBy")
  anggotaUpdated              Anggota[]             @relation("AnggotaUpdatedBy")
  auditLogs                   AuditLog[]
  calonAnggotasDiusul         CalonAnggota[]        @relation("CalonAnggotaUsul")
  dataRevisions               DataRevision[]        @relation("DataRevisionChangedBy")
  deviceTokens                DeviceToken[]
  disposisiDari               Disposisi[]           @relation("DisposisiDari")
  disposisiKepada             Disposisi[]           @relation("DisposisiKepada")
  dokumenOrgUploaded          DokumenOrganisasi[]   @relation("DokumenOrgUploader")
  galeriReviewed              Galeri[]              @relation("GaleriReviewer")
  galeriUploads               Galeri[]              @relation("GaleriUploader")
  hasilPendadaranDivValidated HasilPendadaran[]     @relation("HasilPendadaranValidasi")
  importBatches               ImportBatch[]         @relation("ImportBatchImportedBy")
  iuranDiverifikasi           Iuran[]               @relation("IuranVerifikator")
  kegiatanAdminKegiatan       Kegiatan[]            @relation("AdminKegiatan")
  kegiatanDibuat              Kegiatan[]            @relation("KegiatanCreatedBy")
  kegiatanUpdated             Kegiatan[]            @relation("KegiatanUpdatedBy")
  kepengurusans               Kepengurusan[]
  latihansDipelatih           Latihan[]             @relation("LatihanPelatih")
  nilaiPendadaranPenguji      NilaiPendadaran[]     @relation("NilaiPendadaranPenguji")
  notifikasis                 Notifikasi[]
  oauthAccounts               OAuthAccount[]
  penugasanPengujis           PenugasanPenguji[]
  tandaTangans                TandaTangan[]
  ujianPraktekPenilais        UjianPraktekPenilai[]
  userSessions                UserSession[]
  distrik                     Distrik?              @relation("UserDistrikScope", fields: [distrikId], references: [id])
  ranting                     Ranting?              @relation(fields: [rantingId], references: [id])
  wilayah                     Wilayah?              @relation("UserWilayahScope", fields: [wilayahId], references: [id])

  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  deviceName   String?   @map("device_name")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

model Anggota {
  id                        String                   @id @default(uuid())
  rantingId                 String                   @map("ranting_id")
  nomorAnggota              String                   @map("nomor_anggota")
  namaLengkap               String                   @map("nama_lengkap")
  jenisKelamin              JenisKelamin             @map("jenis_kelamin")
  tempatLahir               String?                  @map("tempat_lahir")
  tanggalLahir              DateTime?                @map("tanggal_lahir")
  alamat                    String?
  noHp                      String?                  @map("no_hp")
  email                     String?
  fotoPath                  String?                  @map("foto_path")
  statusKeanggotaan         StatusKeanggotaan        @default(aktif) @map("status_keanggotaan")
  tingkat                   String?
  statusData                StatusData               @default(complete) @map("status_data")
  statusValidasi            StatusValidasi           @default(pending) @map("status_validasi")
  missingFields             Json?                    @map("missing_fields")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  deletedAt                 DateTime?                @map("deleted_at")
  tahunDadar                String?                  @map("tahun_dadar")
  tempatDadar               String?                  @map("tempat_dadar")
  isImported                Boolean                  @default(false) @map("is_imported")
  importSource              String?                  @map("import_source")
  importedAt                DateTime?                @map("imported_at")
  noHpNormalized            String?                  @map("no_hp_normalized")
  version                   Int                      @default(0) @map("version")
  createdById               String?                  @map("created_by_id")
  updatedById               String?                  @map("updated_by_id")
  absensiLatihans           AbsensiLatihan[]
  createdBy                 User?                    @relation("AnggotaCreatedBy", fields: [createdById], references: [id])
  ranting                   Ranting                  @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  updatedBy                 User?                    @relation("AnggotaUpdatedBy", fields: [updatedById], references: [id])
  ChatMember                ChatMember[]
  ChatMessage               ChatMessage[]
  checkIns                  CheckIn[]
  dokumen                   Dokumen[]
  evaluasiLatihans          EvaluasiLatihan[]
  ForumPost                 ForumPost[]
  ForumThread               ForumThread[]
  gamificationEvents        GamificationEvent[]
  gamificationProfile       GamificationProfile?
  gamificationRedemptions   GamificationRedemption[]
  iuran                     Iuran[]
  iuranRecurrings           IuranRecurring[]
  kegiatanPesertas          KegiatanPeserta[]
  klaims                    Klaim[]
  memberReferralsAsReferred MemberReferral?          @relation("Referred")
  memberReferralsAsReferrer MemberReferral[]         @relation("Referrer")
  nilaiPendadaranAnggota    NilaiPendadaran[]
  presensiKegiatans         PresensiKegiatan[]
  qrCodes                   QrCode[]
  transferRequests          TransferRequest[]
  undanganPendadarans       UndanganPendadaran[]

  @@index([statusData])
  @@index([noHpNormalized])
  @@map("anggota")
}

model CalonAnggota {
  id                 String              @id @default(uuid())
  rantingId          String              @map("ranting_id")
  namaLengkap        String              @map("nama_lengkap")
  jenisKelamin       JenisKelamin        @map("jenis_kelamin")
  tempatLahir        String?             @map("tempat_lahir")
  tanggalLahir       DateTime?           @map("tanggal_lahir")
  alamat             String?
  noHp               String?             @map("no_hp")
  email              String?             @unique
  status             StatusCalon         @default(diusulkan)
  usulOlehUserId     String              @map("usul_oleh_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  tingkat            String?
  ranting            Ranting             @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  usulOlehUser       User                @relation("CalonAnggotaUsul", fields: [usulOlehUserId], references: [id])
  hasilPendadarans   HasilPendadaran[]
  nilaiPendadarans   NilaiPendadaran[]
  pesertaPendadarans PesertaPendadaran[]
  sesiUjianPesertas  SesiUjianPeserta[]

  @@map("calon_anggota")
}

model Pendaftaran {
  id           String         @id @default(uuid())
  namaLengkap  String         @map("nama_lengkap")
  jenisKelamin JenisKelamin   @map("jenis_kelamin")
  tempatLahir  String?        @map("tempat_lahir")
  tanggalLahir DateTime?      @map("tanggal_lahir")
  alamat       String?
  noHp         String?        @map("no_hp")
  email        String?
  sumberInfo   String?        @map("sumber_info")
  status       StatusValidasi @default(pending)
  catatan      String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  rantingId    String?        @map("ranting_id")
  ranting      Ranting?       @relation(fields: [rantingId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([rantingId])
  @@map("pendaftaran")
}

model Klaim {
  id           String      @id @default(uuid())
  anggotaId    String?     @map("anggota_id")
  tipe         TipeKlaim
  status       StatusKlaim @default(pending)
  catatan      String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  version      Int         @default(0) @map("version")
  namaLengkap  String?     @map("nama_lengkap")
  jenisKelamin String?     @map("jenis_kelamin")
  tempatLahir  String?     @map("tempat_lahir")
  tanggalLahir DateTime?   @map("tanggal_lahir")
  alamat       String?
  noHp         String?     @map("no_hp")
  email        String?
  rantingId    String?     @map("ranting_id")
  buktiDokumen Json?       @map("bukti_dokumen")
  approvedBy   String?     @map("approved_by")
  approvedAt   DateTime?   @map("approved_at")
  tempatDadar  String?     @map("tempat_dadar")
  tahunDadar   String?     @map("tahun_dadar")
  anggota      Anggota?    @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  ranting      Ranting?    @relation(fields: [rantingId], references: [id])

  @@index([anggotaId])
  @@index([rantingId])
  @@map("klaim")
}

model Kegiatan {
  id                 String               @id @default(uuid())
  scopeType          ScopeType            @map("scope_type")
  scopeId            String               @map("scope_id")
  nama               String
  tipe               TipeKegiatan
  lokasi             String?
  tanggalMulai       DateTime             @map("tanggal_mulai")
  tanggalSelesai     DateTime             @map("tanggal_selesai")
  createdBy          String               @map("created_by")
  status             StatusKegiatan       @default(draft)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  adminKegiatanId    String?              @map("admin_kegiatan_id")
  pengajuanNilaiOleh String?              @map("pengajuan_nilai_oleh")
  pengajuanNilaiAt   DateTime?            @map("pengajuan_nilai_at")
  updatedById        String?              @map("updated_by_id")
  aspekPenilaians    AspekPenilaian[]     @relation("AspekPenilaianKegiatan")
  checkIns           CheckIn[]
  dokumenKegiatan    DokumenKegiatan[]
  hasilPendadarans   HasilPendadaran[]
  adminKegiatan      User?                @relation("AdminKegiatan", fields: [adminKegiatanId], references: [id])
  creator            User                 @relation("KegiatanCreatedBy", fields: [createdBy], references: [id])
  updatedBy          User?                @relation("KegiatanUpdatedBy", fields: [updatedById], references: [id])
  peserta            KegiatanPeserta[]
  latihans           Latihan[]
  nilaiPendadarans   NilaiPendadaran[]
  penugasanPengujis  PenugasanPenguji[]
  pesertaPendadarans PesertaPendadaran[]
  presensi           PresensiKegiatan[]
  ujianPrakteks      UjianPraktek[]
  undangans          UndanganPendadaran[]

  @@map("kegiatan")
}

model UndanganPendadaran {
  id             String         @id @default(uuid())
  kegiatanId     String         @map("kegiatan_id")
  anggotaId      String         @map("anggota_id")
  status         StatusUndangan @default(dikirim)
  dikirimAt      DateTime       @default(now()) @map("dikirim_at")
  konfirmasiAt   DateTime?      @map("konfirmasi_at")
  konfirmasiOleh String?        @map("konfirmasi_oleh")
  catatan        String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  anggota        Anggota        @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  kegiatan       Kegiatan       @relation(fields: [kegiatanId], references: [id])

  @@unique([kegiatanId, anggotaId])
  @@map("undangan_pendadaran")
}

model Latihan {
  id                           String            @id @default(uuid())
  rantingId                    String            @map("ranting_id")
  kegiatanId                   String?           @map("kegiatan_id")
  pelatihId                    String            @map("pelatih_id")
  hariTanggal                  DateTime          @map("hari_tanggal")
  lokasi                       String?
  jenisMateri                  String?           @map("jenis_materi")
  hasilLatihanGlobal           String?           @map("hasil_latihan_global")
  rekomendasiLatihanBerikutnya String?           @map("rekomendasi_latihan_berikutnya")
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")
  absensi                      AbsensiLatihan[]
  checkIns                     CheckIn[]
  evaluasi                     EvaluasiLatihan[]
  kegiatan                     Kegiatan?         @relation(fields: [kegiatanId], references: [id])
  pelatih                      User              @relation("LatihanPelatih", fields: [pelatihId], references: [id])
  ranting                      Ranting           @relation(fields: [rantingId], references: [id], onDelete: Cascade)
  materi                       MateriLatihan[]

  @@index([rantingId])
  @@map("latihan")
}

model MateriLatihan {
  id        String         @id @default(uuid())
  latihanId String         @map("latihan_id")
  kategori  KategoriMateri
  detail    String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  latihan   Latihan        @relation(fields: [latihanId], references: [id], onDelete: Cascade)

  @@index([latihanId])
  @@map("materi_latihan")
}

model AbsensiLatihan {
  id        String   @id @default(uuid())
  latihanId String   @map("latihan_id")
  anggotaId String   @map("anggota_id")
  hadir     Boolean  @default(true)
  catatan   String?
  createdAt DateTime @default(now()) @map("created_at")
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  latihan   Latihan  @relation(fields: [latihanId], references: [id], onDelete: Cascade)

  @@unique([latihanId, anggotaId])
  @@index([anggotaId])
  @@map("absensi_latihan")
}

model EvaluasiLatihan {
  id        String   @id @default(uuid())
  latihanId String   @map("latihan_id")
  anggotaId String   @map("anggota_id")
  nilai     Decimal  @db.Decimal(5, 2)
  catatan   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  latihan   Latihan  @relation(fields: [latihanId], references: [id], onDelete: Cascade)

  @@index([latihanId])
  @@index([anggotaId])
  @@map("evaluasi_latihan")
}

model KegiatanPeserta {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  anggotaId  String   @map("anggota_id")
  createdAt  DateTime @default(now()) @map("created_at")
  anggota    Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])

  @@unique([kegiatanId, anggotaId])
  @@index([anggotaId])
  @@map("kegiatan_peserta")
}

model PresensiKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  anggotaId  String   @map("anggota_id")
  hadir      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  anggota    Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])

  @@unique([kegiatanId, anggotaId])
  @@index([anggotaId])
  @@map("presensi_kegiatan")
}

model DokumenKegiatan {
  id         String   @id @default(uuid())
  kegiatanId String   @map("kegiatan_id")
  nama       String
  filePath   String?  @map("file_path")
  tipe       String
  createdAt  DateTime @default(now()) @map("created_at")
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id])

  @@map("dokumen_kegiatan")
}

model AspekPenilaian {
  id            String          @id @default(uuid())
  kodeAspek     String          @unique @map("kode_aspek")
  namaAspek     String          @map("nama_aspek")
  deskripsi     String?
  bobot         Decimal         @default(0)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  kegiatanId    String?         @map("kegiatan_id")
  kegiatan      Kegiatan?       @relation("AspekPenilaianKegiatan", fields: [kegiatanId], references: [id], onDelete: Cascade)
  itemPenilaian ItemPenilaian[]

  @@index([kegiatanId])
  @@index([kodeAspek])
