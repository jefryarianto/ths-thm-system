# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ths_thm?schema=public

# JWT / Auth
JWT_SECRET=change-me-to-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/auth/linkedin/callback

# Email - Resend (primary): https://resend.com (free 100/day)
RESEND_API_KEY=re_xxx
RESEND_DOMAIN=ths-thm.cloud
RESEND_WEBHOOK_SECRET=

# Email - SMTP (fallback, optional)
# Gmail: enable 2FA -> generate App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Firebase Cloud Messaging (push notifications)
# Generate service account from Firebase Console -> Settings -> Service Accounts
FCM_PROJECT_ID=your-firebase-project-id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Payment - Manual Transfer + QRIS
# Bank account info for manual transfer
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=THS-THM Organisasi
# QRIS image URL (optional, upload ke storage/public)
QRIS_IMAGE_URL=https://ths-thm.cloud/uploads/qris.png

# Server
APP_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# API keys (service-to-service auth)
API_KEYS=[{"key":"generate-a-random-key-here","name":"Local Dev"}]
