# Prisma migrations must be tracked in git (needed for CI's prisma migrate deploy)
# NOTE: do NOT ignore migration directories here — git cannot re-include
# migration.sql inside an ignored directory (new migrations would be lost).

# Security sensitive files (MUST NOT be committed)
check.sql
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
apps/api/.env
apps/api/ths-thm-system-*-firebase-adminsdk-*.json
